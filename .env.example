# Copy to .env and fill in. .env is gitignored and must never be committed.
# Raw key drops (api.txt, *.key, *secret*) are gitignored too.

# ── LLM (provider agnostic; switching is an env change, not a code change) ──
# anthropic | openai | azure_openai | google_genai | groq | ollama | mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_TEMPERATURE=0.0

# Other combinations:
#   LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-4-5-20250929
#   LLM_PROVIDER=mock                      # keyword rules, no key, full pipeline
# For a local or OpenAI-compatible endpoint, also set:
#   LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Census ACS: on-demand socioeconomic attributes for Census places ──
# Free key, but now required for EVERY query - the old keyless allowance is gone.
# Request one at https://api.census.gov/data/key_signup.html
# Without it the API returns an HTML page as HTTP 200, not an error.
CENSUS_API_KEY=

# ── Geocoding: the only external call Task 1 makes ──
# Nominatim's terms require an identifiable User-Agent; use your own contact.
GEOCODER_USER_AGENT=wildfire-analyst-agent/0.1 (your-email@example.com)
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# ── Local data ──
# One allow-listed directory. Relative paths are resolved from the repository root.
# The model receives metadata and relative dataset ids, never arbitrary filesystem access.
#
# The default below contains only the committed Altadena showcase snapshot. The
# derived analyses need the TS-SatFire archive, which is NOT in this repository -
# point this at your own copy instead. Without it the catalogue is empty and no
# historical fire matches, silently. See backend/data/README.md for the layout.
LOCAL_DATA_ROOT=backend/data

# ── Downstream data source (unused by Task 1; reserved for the Planning Agent) ──
# Never hard-code localhost:3000 anywhere in the code - read it from here.
# MADISON_API_BASE_URL=http://localhost:3000

# ── Service ──
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
